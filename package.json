{
  "name": "chainkyc-root",
  "version": "1.0.0",
  "description": "ChainKYC - Blockchain-Based Decentralized KYC & Identity Verification",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "test:contracts": "npm run test --prefix blockchain",
    "test:backend": "node --test backend/test/*.test.js",
